    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "mathjs": "^14.0.0",
    "katex": "^0.16.0",
    "react-katex": "^3.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.11.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
