{
  "name": "northstar-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:maths": "node --experimental-strip-types --test tests/math-generator.test.mjs tests/math-answer-validation.test.mjs tests/math-review.test.mjs",
    "test:assessment": "node --experimental-strip-types --test tests/assessment-items.test.mjs tests/assessment-security.test.mjs",
