    "test:chat": "node --experimental-strip-types --test tests/chat-policy.test.mjs tests/biology-videos.test.mjs",
    "videos:check": "node --experimental-strip-types scripts/check-biology-videos.mjs",
    "videos:check:offline": "node --experimental-strip-types scripts/check-biology-videos.mjs --offline"
  },
  "dependencies": {
    "next": "^15.5.0",
