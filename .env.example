# Hosted Postgres (Supabase → Connect → Session or Transaction pooler). SERVER ONLY.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require
# If available, paste the trusted CA PEM certificate on one line with escaped newlines.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Do not prefix DATABASE_URL with NEXT_PUBLIC_.
# Run scripts/create-teacher.mjs with INITIAL_TEACHER_* environment variables only for setup.
# Vercel Cron authenticates with CRON_SECRET; use a long, random server-only value.
CRON_SECRET=

# tawk.to chat widget. Property ID and Widget ID are public widget identifiers, not secrets.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=default
# Secret property API key (Administration > Property Settings). Server-only.
# Required for Secure Mode; student chat is disabled if missing.
TAWK_API_KEY=
# Ticket email replies and teacher notifications are configured in tawk.to's dashboard,
# not with Resend or an application email environment variable.

# B5: npm run videos:check verifies YouTube oEmbed metadata.
