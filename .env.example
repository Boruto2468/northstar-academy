# Hosted Postgres (Supabase → Connect → Session or Transaction pooler). SERVER ONLY.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require
# If available, paste the trusted CA PEM certificate on one line with escaped newlines.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Do not prefix DATABASE_URL with NEXT_PUBLIC_.
# Run scripts/create-teacher.mjs with INITIAL_TEACHER_* environment variables only for setup.
# Vercel Cron authenticates with CRON_SECRET; use a long, random server-only value.
CRON_SECRET=

# B4 chat (server-only; optional features gracefully disabled if not configured).
# Get an Anthropic API key from https://console.anthropic.com; never use NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=
# As of 2026-11, Anthropic offers Sonnet 5.5; check the current model list.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Email notifications: Resend requires a verified sender domain for production sending.
RESEND_API_KEY=
CHAT_EMAIL_TO=
CHAT_EMAIL_FROM=
APP_BASE_URL=https://YOUR-APP.vercel.app
# B5 optional checking: npm run videos:check uses YouTube oEmbed (no API key).
